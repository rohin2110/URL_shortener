# --- Database (Supabase) ---------------------------------------------------
# Use the Supabase *Session pooler* URI (IPv4, port 5432) and swap the scheme to
# postgresql+asyncpg://. Keep ?ssl=require. If you use the *Transaction pooler*
# (port 6543) instead, the app disables prepared-statement caching automatically.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# --- Redis -----------------------------------------------------------------
# "redis" is the docker compose service name.
REDIS_URL=redis://redis:6379/0

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Click analytics -------------------------------------------------------
# HMAC key used to hash visitor IPs (raw IPs are never stored).
IP_HASH_SECRET=change-me-to-another-random-string

# Public origin used to build short links, e.g. https://sho.rt
BASE_URL=http://localhost:8000

# Header carrying the real client IP, set by a trusted edge proxy (e.g. Fly-Client-IP
# on Fly.io). Leave empty unless ALL traffic goes through that proxy — otherwise
# clients could spoof it to dodge rate limits.
CLIENT_IP_HEADER=

# --- Caching ---------------------------------------------------------------
URL_CACHE_TTL_SECONDS=86400
NOT_FOUND_CACHE_TTL_SECONDS=60

# --- Rate limiting (requests per window) ------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# per client IP, applied to /api/auth/*
RATE_LIMIT_AUTH=10
# per authenticated user, applied to POST /api/urls
RATE_LIMIT_CREATE_URL=30
# per client IP, applied to GET /{code}
RATE_LIMIT_REDIRECT=300

# --- Tests (set by docker compose's `tests` service; override only if needed) --
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-test:5432/urlshortener_test
TEST_REDIS_URL=redis://redis:6379/15
